import { Theme, Icons, Press } from "theme.slint";
import { Poster, Row, KeyCap, TrackItem } from "types.slint";
import { CardGlow, PillGlow } from "glow.slint";

// Poster artwork with a fallback tile, focus glow and progress bar.
export component PosterCard inherits Rectangle {
    in property <Poster> item;
    in property <bool> focused;
    in property <bool> show-title: false;
    width: Theme.poster-w;
    height: Theme.poster-h + (show-title ? 42px : 0px);

    // Culling box: see CULL.
    Rectangle {
        x: -Theme.cull-pad;
        y: -Theme.cull-pad;
        width: root.width + 2 * Theme.cull-pad;
        height: root.height + 2 * Theme.cull-pad;
        clip: true;
        Rectangle {
            x: Theme.cull-pad;
            y: Theme.cull-pad;
            width: root.width;
            height: root.height;

            // Focus lift: scales the glow and the artwork together.
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: Theme.poster-h;
                transform-scale: root.focused ? (Press.down ? 1.02 : Theme.focus-scale) : 1.0;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                animate transform-scale { duration: Theme.fast; easing: ease-out-quart; }

                CardGlow {
                    width: parent.width;
                    height: parent.height;
                    on: root.focused;
                }

                // No clip: the artwork's corners are rounded when it's decoded
                // (ImageKind::card_radius). A rounded clip renders each card into its
                // own offscreen texture, which is what made rows stutter on TVs.
                art := Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.surface-2;

                    if !root.item.has-image: Rectangle {
                        border-radius: Theme.radius;
                        background: @linear-gradient(160deg, Theme.surface-3 0%, Theme.surface 100%);
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: root.item.title;
                            color: Theme.text-muted;
                            font-size: Theme.text-md;
                            font-weight: 600;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.item.image;
                        image-fit: cover;
                        opacity: root.item.has-image ? 1 : 0;
                        animate opacity { duration: Theme.med; }
                    }
                    if root.item.progress > 0: Rectangle {
                        x: 6px;
                        y: parent.height - 10px;
                        width: parent.width - 12px;
                        height: 4px;
                        border-radius: 2px;
                        background: #000000aa;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.item.progress, 0, 1);
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }
                    if root.item.badge != "": Rectangle {
                        x: 6px;
                        y: 6px;
                        width: badge-text.preferred-width + 10px;
                        height: 16px;
                        border-radius: 4px;
                        background: Theme.accent-deep;
                        badge-text := Text {
                            text: root.item.badge;
                            font-size: Theme.text-xs;
                            font-weight: 700;
                            color: white;
                        }
                    }
                    Rectangle {
                        border-radius: Theme.radius;
                        border-width: root.focused ? 2px : 0px;
                        border-color: Theme.accent-light;
                    }
                }
            }

            if root.show-title: Text {
                y: Theme.poster-h + 8px;
                width: parent.width;
                text: root.item.title;
                color: root.focused ? Theme.text : Theme.text-muted;
                font-size: Theme.text-sm;
                font-weight: 500;
                // Two lines: seven columns leave 104px, too little for most titles on one.
                wrap: word-wrap;
                overflow: elide;
                height: 34px;
            }
        }
    }
}

// Landscape card for Continue Watching.
export component WideCard inherits Rectangle {
    in property <Poster> item;
    in property <bool> focused;
    width: Theme.wide-w;
    height: Theme.wide-h + 34px;

    // Culling box: see CULL.
    Rectangle {
        x: -Theme.cull-pad;
        y: -Theme.cull-pad;
        width: root.width + 2 * Theme.cull-pad;
        height: root.height + 2 * Theme.cull-pad;
        clip: true;
        Rectangle {
            x: Theme.cull-pad;
            y: Theme.cull-pad;
            width: root.width;
            height: root.height;

            // Focus lift: scales the glow and the artwork together.
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: Theme.wide-h;
                transform-scale: root.focused ? (Press.down ? 1.02 : Theme.focus-scale) : 1.0;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                animate transform-scale { duration: Theme.fast; easing: ease-out-quart; }

                CardGlow {
                    width: parent.width;
                    height: parent.height;
                    on: root.focused;
                }

                // No clip, as in PosterCard: the artwork has rounded corners baked in.
                art := Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.surface-2;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.item.image;
                        image-fit: cover;
                        opacity: root.item.has-image ? 1 : 0;
                        animate opacity { duration: Theme.med; }
                    }
                    Rectangle {
                        border-radius: Theme.radius;
                        background: @linear-gradient(180deg, #00000000 45%, #000000cc 100%);
                    }
                    Text {
                        x: 10px;
                        y: parent.height - 30px;
                        width: parent.width - 20px;
                        text: root.item.title;
                        color: Theme.text;
                        font-size: Theme.text-md;
                        font-weight: 700;
                        overflow: elide;
                    }
                    if root.item.badge != "": Rectangle {
                        x: 8px;
                        y: 8px;
                        width: wide-badge.preferred-width + 10px;
                        height: 16px;
                        border-radius: 4px;
                        background: Theme.accent-deep;
                        wide-badge := Text {
                            text: root.item.badge;
                            font-size: Theme.text-xs;
                            font-weight: 700;
                            color: white;
                        }
                    }
                    if root.item.progress > 0: Rectangle {
                        x: 6px;
                        y: parent.height - 10px;
                        width: parent.width - 12px;
                        height: 4px;
                        border-radius: 2px;
                        background: #000000aa;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.item.progress, 0, 1);
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }
                    Rectangle {
                        border-radius: Theme.radius;
                        border-width: root.focused ? 2px : 0px;
                        border-color: Theme.accent-light;
                    }
                }
            }
            Text {
                y: Theme.wide-h + 8px;
                width: parent.width;
                text: root.item.subtitle;
                color: root.focused ? Theme.text : Theme.text-muted;
                font-size: Theme.text-sm;
                overflow: elide;
            }
        }
    }
}

// A titled horizontal row. The focused card stays at the left edge (Netflix-style).
export component PosterRow inherits Rectangle {
    in property <Row> data;
    in property <bool> active;
    in property <length> left-pad: Theme.safe-x;
    property <length> card-w: data.wide ? Theme.wide-w : Theme.poster-w;
    property <length> card-h: data.wide ? Theme.wide-h + 34px : Theme.poster-h;
    height: self.preferred-height;
    preferred-height: data.hidden ? 0px : 26px + card-h + 18px;
    visible: !data.hidden;

    // Culling box: see CULL. Rows scrolled out of view cost one element.
    Rectangle {
        y: -Theme.cull-pad;
        height: root.height + 2 * Theme.cull-pad;
        clip: true;
        Rectangle {
            y: Theme.cull-pad;
            height: root.height;

            Text {
                x: root.left-pad;
                y: 0;
                text: root.data.title;
                color: root.active ? Theme.text : Theme.text-muted;
                font-size: Theme.text-lg;
                font-weight: 700;
                animate color { duration: Theme.fast; }
            }

            if root.data.loading: HorizontalLayout {
                x: root.left-pad;
                y: 28px;
                spacing: Theme.card-gap;
                for i in 7: Rectangle {
                    width: root.card-w;
                    height: root.data.wide ? Theme.wide-h : Theme.poster-h;
                    border-radius: Theme.radius;
                    background: Theme.surface;
                }
            }

            if !root.data.loading && root.data.items.length == 0: Text {
                x: root.left-pad;
                y: 40px;
                text: root.data.empty-text;
                color: Theme.text-faint;
                font-size: Theme.text-md;
            }

            strip := Rectangle {
                x: root.left-pad - root.data.focused-col * (root.card-w + Theme.card-gap);
                y: 28px;
                width: root.data.items.length * (root.card-w + Theme.card-gap);
                height: root.card-h;
                animate x { duration: Theme.scroll; easing: cubic-bezier(0.2, 0.6, 0.3, 1); }

                for item[i] in root.data.items: Rectangle {
                    x: i * (root.card-w + Theme.card-gap);
                    width: root.card-w;
                    height: root.card-h;
                    if root.data.wide: WideCard {
                        item: item;
                        focused: root.active && i == root.data.focused-col;
                    }
                    if !root.data.wide: PosterCard {
                        item: item;
                        focused: root.active && i == root.data.focused-col;
                    }
                }
            }
        }
    }
}

// Pill button. Focus fills it with the accent.
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> focused;
    in property <bool> primary: false;
    in property <bool> compact: false;
    // A fixed width with the label on the left (action sheets); 0 = fit the label.
    in property <length> fill-width: 0px;
    // Grow to the right only (the first button of a row stays on the column edge).
    in property <bool> grow-right: false;
    property <bool> stretch: fill-width > 0px;
    height: compact ? 30px : 36px;
    width: stretch ? fill-width : content.preferred-width + (compact ? 24px : 32px);
    // Full-width buttons don't grow (they'd stick out of their column); fill and glow show focus.
    transform-scale: focused && !stretch ? 1.05 : 1.0;
    transform-origin: { x: root.grow-right ? 0px : self.width / 2, y: self.height / 2 };
    animate transform-scale { duration: Theme.fast; easing: ease-out-quart; }

    PillGlow {
        width: parent.width;
        height: parent.height;
        on: root.focused;
    }
    Rectangle {
        border-radius: self.height / 2;
        background: root.focused ? Theme.accent : (root.primary ? Theme.surface-3 : Theme.surface-2);
        border-width: root.focused ? 0px : 1px;
        border-color: Theme.border;
        animate background { duration: Theme.fast; easing: ease-out-quart; }
    }

    content := HorizontalLayout {
        alignment: root.stretch ? start : center;
        padding-left: root.stretch ? 16px : 0px;
        spacing: 8px;
        if root.has-icon: Image {
            source: root.icon;
            width: root.compact ? 13px : 15px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            colorize: Theme.text;
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: root.compact ? Theme.text-sm : Theme.text-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Small rounded label (filters, badges, season chips).
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> selected;
    // A ▾ icon: the chip opens a list.
    in property <bool> dropdown;
    height: 28px;
    width: chip-row.preferred-width + 24px;
    border-radius: 14px;
    background: focused ? Theme.accent : (selected ? Theme.surface-3 : transparent);
    border-width: (focused || selected) ? 0px : 1px;
    border-color: Theme.border;
    animate background { duration: Theme.fast; }
    chip-row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.label;
            color: (root.focused || root.selected) ? Theme.text : Theme.text-muted;
            font-size: Theme.text-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.dropdown: Image {
            source: Icons.chevron-down;
            width: 11px;
            height: 11px;
            y: (parent.height - self.height) / 2;
            colorize: (root.focused || root.selected) ? Theme.text : Theme.text-muted;
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> label;
    in property <color> tint: #ffffff1c;
    in property <color> text-color: Theme.text;
    height: 17px;
    width: badge-label.preferred-width + 12px;
    border-radius: 4px;
    background: tint;
    badge-label := Text {
        text: root.label;
        font-size: Theme.text-xs;
        font-weight: 700;
        color: root.text-color;
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.accent;
    height: 4px;
    border-radius: 2px;
    background: #ffffff26;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 2px;
        background: root.fill;
        animate width { duration: Theme.med; }
    }
}

// Rotating arc spinner.
export component Spinner inherits Rectangle {
    in property <length> size: 28px;
    width: size;
    height: size;
    property <angle> spin: animation-tick() * 300deg / 1s;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Theme.accent;
        stroke-width: 3px;
        transform-rotation: root.spin;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        MoveTo { x: 12; y: 2.5; }
        ArcTo { x: 21.5; y: 12; radius-x: 9.5; radius-y: 9.5; sweep: true; }
    }
}

// The on-screen keyboard used by Search and key entry.
export component KeyboardGrid inherits Rectangle {
    in property <[KeyCap]> keys;
    in property <int> columns: 6;
    in property <int> rows: 7;
    in property <int> focused-index: -1;
    in property <length> key-size: 34px;
    property <length> gap: 5px;
    width: columns * (key-size + gap) - gap;
    height: rows * (key-size + gap) - gap;

    for key[i] in root.keys: Rectangle {
        x: key.col * (root.key-size + root.gap);
        y: key.row * (root.key-size + root.gap);
        width: key.span * (root.key-size + root.gap) - root.gap;
        height: root.key-size;
        border-radius: Theme.radius-sm;
        background: i == root.focused-index ? Theme.accent : Theme.surface-2;
        animate background { duration: 90ms; }
        if key.has-icon: Image {
            source: key.icon;
            width: 16px;
            height: 16px;
            colorize: Theme.text;
        }
        if !key.has-icon: Text {
            text: key.label;
            color: Theme.text;
            font-size: Theme.text-lg;
            font-weight: 600;
        }
    }
}

// Vertical list of selectable tracks/options with a check mark.
export component OptionList inherits Rectangle {
    in property <string> title;
    in property <[TrackItem]> options;
    in property <int> focused-index;
    width: 280px;
    height: min(list.preferred-height + 56px, 400px);
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 30px;
    drop-shadow-color: #00000099;
    clip: true;

    Text {
        x: 18px;
        y: 16px;
        text: root.title;
        color: Theme.text;
        font-size: Theme.text-lg;
        font-weight: 700;
    }
    property <length> item-h: 32px;
    property <length> visible-h: root.height - 52px;
    property <length> scroll: max(0px, min(root.focused-index * item-h - visible-h / 2 + item-h / 2, root.options.length * item-h - visible-h));
    Rectangle {
        y: 46px;
        height: root.visible-h;
        clip: true;
        list := Rectangle {
            y: -root.scroll;
            height: root.options.length * root.item-h;
            preferred-height: root.options.length * root.item-h;
            animate y { duration: Theme.fast; }
            for option[i] in root.options: Rectangle {
                x: 8px;
                y: i * root.item-h;
                width: parent.width - 16px;
                height: root.item-h - 2px;
                border-radius: Theme.radius-sm;
                background: i == root.focused-index ? Theme.accent : transparent;
                Image {
                    x: 10px;
                    width: 14px;
                    height: 14px;
                    source: Icons.check;
                    colorize: Theme.text;
                    opacity: option.selected ? 1 : 0;
                }
                Text {
                    x: 32px;
                    width: parent.width - 40px;
                    text: option.label;
                    color: Theme.text;
                    font-size: Theme.text-md;
                    font-weight: option.selected ? 700 : 500;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Bottom-right transient message.
export component Toast inherits Rectangle {
    in property <string> message;
    in property <bool> shown;
    width: min(toast-text.preferred-width + 36px, 420px);
    height: toast-text.preferred-height + 22px;
    border-radius: Theme.radius;
    background: Theme.surface-3;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000aa;
    opacity: shown ? 1 : 0;
    animate opacity { duration: Theme.med; }
    toast-text := Text {
        x: 18px;
        width: parent.width - 36px;
        text: root.message;
        color: Theme.text;
        font-size: Theme.text-md;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}
