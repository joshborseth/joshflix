import { Theme, Icons } from "theme.slint";
import { Poster, Row, TrackItem } from "types.slint";
import { PosterCard, PosterRow, Chip, Spinner, OptionList } from "components.slint";

// Poster grid with focus scrolling. Used by Discover and My List.
export component PosterGrid inherits Rectangle {
    in property <[Poster]> items;
    in property <int> columns: 7;
    in property <int> focused-index: -1;
    in property <bool> centered: false;
    // Room inside the clip for the focus glow of the first column and row.
    in property <length> pad-x: 24px;
    in property <length> pad-y: 8px;
    property <length> cell-w: Theme.poster-w + 18px;
    // Two rows and a peek of the third fit, with titles above the overscan band.
    property <length> cell-h: Theme.poster-h + 50px;
    property <int> focused-line: root.focused-index < 0 ? 0 : floor(root.focused-index / root.columns);
    property <length> grid-w: root.columns * root.cell-w;
    clip: true;

    Rectangle {
        x: root.pad-x + (root.centered ? (root.width - root.pad-x - root.grid-w) / 2 : 0px);
        y: root.pad-y + 8px - max(0, root.focused-line - 1) * root.cell-h;
        width: root.grid-w;
        animate y { duration: Theme.med; easing: ease-out-quart; }
        for item[i] in root.items: PosterCard {
            x: mod(i, root.columns) * root.cell-w + 6px;
            y: floor(i / root.columns) * root.cell-h;
            item: item;
            show-title: true;
            focused: i == root.focused-index;
        }
    }
}

export component DiscoverScreen inherits Rectangle {
    in property <[string]> filters;        // "Movies", "Popular", "All genres"
    in property <[Poster]> items;
    in property <bool> loading;
    in property <string> message;          // empty or error text when nothing shows
    in property <bool> active;
    in property <int> zone;                // 0 filters, 1 grid
    in property <int> filter-index;
    in property <int> grid-index;
    in property <int> columns: 7;
    // Picker
    in property <bool> picker-open;
    in property <string> picker-title;
    in property <[TrackItem]> picker-options;
    in property <int> picker-index;
    in property <length> left-pad: Theme.rail-collapsed + 28px;
    background: Theme.bg;

    Text {
        x: root.left-pad;
        y: Theme.safe-y;
        text: "Discover";
        color: Theme.text;
        font-size: Theme.text-2xl;
        font-weight: 900;
    }
    HorizontalLayout {
        x: root.left-pad;
        y: Theme.safe-y + 40px;
        height: 28px;
        spacing: 10px;
        alignment: start;
        // Equal widths, so the picker can open under its chip.
        for filter[i] in root.filters: Chip {
            width: 110px;
            label: filter;
            dropdown: true;
            selected: true;
            focused: root.active && root.zone == 0 && i == root.filter-index;
        }
    }
    if root.loading && root.items.length == 0: Spinner {
        x: root.left-pad;
        y: Theme.safe-y + 96px;
    }
    if !root.loading && root.items.length == 0 && root.message != "": Text {
        x: root.left-pad;
        y: Theme.safe-y + 96px;
        width: min(520px, root.width - self.x - Theme.safe-x);
        text: root.message;
        color: Theme.text-muted;
        font-size: Theme.text-lg;
        wrap: word-wrap;
    }
    // More pages on their way while scrolling near the end.
    if root.loading && root.items.length > 0: Spinner {
        x: root.width - Theme.safe-x - self.width;
        y: Theme.safe-y + 40px;
        size: 20px;
    }
    PosterGrid {
        x: root.left-pad - 6px - self.pad-x;
        y: Theme.safe-y + 84px - self.pad-y;
        width: root.width - self.x - 12px;
        height: root.height - self.y;
        items: root.items;
        columns: root.columns;
        focused-index: root.active && root.zone == 1 ? root.grid-index : -1;
    }
    if root.picker-open: OptionList {
        x: root.left-pad + root.filter-index * 120px;
        y: Theme.safe-y + 76px;
        title: root.picker-title;
        options: root.picker-options;
        focused-index: root.picker-index;
    }
}

export component MyListScreen inherits Rectangle {
    in property <Row> continue-row;
    in property <[Poster]> items;
    in property <bool> active;
    in property <int> zone;                // 0 continue watching, 1 grid
    in property <int> grid-index;
    in property <int> columns: 7;
    in property <length> left-pad: Theme.rail-collapsed + 28px;
    property <bool> has-continue: root.continue-row.items.length > 0;
    background: Theme.bg;

    Text {
        x: root.left-pad;
        y: Theme.safe-y;
        text: "My List";
        color: Theme.text;
        font-size: Theme.text-2xl;
        font-weight: 900;
    }
    // Slides up out of a plain clip under the title (no fade: an opacity
    // animation renders the whole row offscreen every frame).
    if root.has-continue: Rectangle {
        y: Theme.safe-y + 36px;
        height: root.height - self.y;
        clip: true;
        PosterRow {
            y: 8px - (root.zone == 1 ? 260px : 0px);
            data: root.continue-row;
            left-pad: root.left-pad;
            active: root.active && root.zone == 0;
            animate y { duration: Theme.med; easing: ease-out-quart; }
        }
    }
    if root.items.length == 0: VerticalLayout {
        x: root.left-pad;
        y: root.has-continue ? Theme.safe-y + 250px : Theme.safe-y + 60px;
        width: 420px;
        height: self.preferred-height;
        spacing: 8px;
        alignment: start;
        Text {
            text: "Nothing saved yet";
            color: Theme.text;
            font-size: Theme.text-xl;
            font-weight: 800;
        }
        Text {
            text: "Open any movie or show and choose “My List” to save it here.";
            color: Theme.text-muted;
            font-size: Theme.text-md;
            wrap: word-wrap;
        }
    }
    if root.items.length > 0: Text {
        x: root.left-pad;
        y: root.has-continue && root.zone == 0 ? Theme.safe-y + 252px : Theme.safe-y + 44px;
        text: "Saved";
        color: root.zone == 1 ? Theme.text : Theme.text-muted;
        font-size: Theme.text-lg;
        font-weight: 700;
        animate y { duration: Theme.med; easing: ease-out-quart; }
    }
    PosterGrid {
        x: root.left-pad - 6px - self.pad-x;
        y: (root.has-continue && root.zone == 0 ? Theme.safe-y + 278px : Theme.safe-y + 70px) - self.pad-y;
        width: root.width - self.x - 12px;
        height: root.height - self.y;
        items: root.items;
        columns: root.columns;
        focused-index: root.active && root.zone == 1 ? root.grid-index : -1;
        animate y { duration: Theme.med; easing: ease-out-quart; }
    }
}
