// Design tokens. Lengths are designed for Android TV's 960×540 dp canvas
// (desktop dev runs at 1920×1080 with SLINT_SCALE_FACTOR=2).

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-Black.ttf";

export global Theme {
    // Surfaces
    out property <color> bg: #0b0d12;
    out property <color> bg-raised: #10131a;
    out property <color> surface: #151923;
    out property <color> surface-2: #1c2230;
    out property <color> surface-3: #262d3d;
    out property <color> border: #252b38;
    out property <color> scrim: #0b0d12e6;

    // Text
    out property <color> text: #f2f4f8;
    out property <color> text-muted: #9aa3b2;
    out property <color> text-faint: #868ea0;

    // Accent: electric blue
    out property <color> accent: #3d8bff;
    out property <color> accent-light: #7db3ff;
    out property <color> accent-deep: #1f5fd1;
    out property <color> accent-soft: #3d8bff2e;
    out property <color> glow: #3d8bff99;

    // Status
    out property <color> success: #34d399;
    out property <color> warning: #fbbf24;
    out property <color> danger: #f87171;

    // Type scale
    out property <length> text-xs: 12px;
    out property <length> text-sm: 13px;
    out property <length> text-md: 14px;
    out property <length> text-lg: 14px;
    out property <length> text-xl: 18px;
    out property <length> text-2xl: 24px;
    out property <length> text-3xl: 32px;
    out property <length> text-hero: 40px;

    // Layout
    out property <length> safe-x: 40px;
    out property <length> safe-y: 24px;
    out property <length> rail-collapsed: 52px;
    out property <length> rail-expanded: 184px;
    out property <length> radius-sm: 6px;
    out property <length> radius: 10px;
    out property <length> radius-lg: 16px;

    // Cards
    out property <length> poster-w: 104px;
    out property <length> poster-h: 156px;
    out property <length> wide-w: 196px;
    out property <length> wide-h: 110px;
    out property <length> card-gap: 12px;
    out property <float> focus-scale: 1.08;
    // CULL: Slint visits every element of the tree on every frame, including
    // children of elements that are off screen (children may draw outside
    // their parent). On a TV CPU, walking all 480 home cards took most of the
    // 16.7 ms frame. A clipping box whose rectangle is off screen is skipped
    // with all its children, so cards and rows sit in one. A plain
    // rectangular clip is only a scissor (no offscreen layer). The padding
    // leaves room for the focus glow and lift.
    out property <length> cull-pad: 40px;

    // Motion
    out property <duration> fast: 140ms;
    out property <duration> med: 220ms;
    out property <duration> slow: 380ms;
    // Row scrolling. A softer curve than ease-out-quart, which covers a quarter
    // of the distance in the first frame and reads as a jump on a 60 Hz TV.
    out property <duration> scroll: 300ms;
}

// OK is held down on a focused card (cards act on release; this gives the
// press immediate feedback).
export global Press {
    in property <bool> down;
}

export global Icons {
    out property <image> search: @image-url("icons/search.svg");
    out property <image> home: @image-url("icons/home.svg");
    out property <image> film: @image-url("icons/film.svg");
    out property <image> tv: @image-url("icons/tv.svg");
    out property <image> compass: @image-url("icons/compass.svg");
    out property <image> bookmark: @image-url("icons/bookmark.svg");
    out property <image> settings: @image-url("icons/settings.svg");
    out property <image> play: @image-url("icons/play.svg");
    out property <image> pause: @image-url("icons/pause.svg");
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> back: @image-url("icons/back.svg");
    out property <image> chevron-right: @image-url("icons/chevron-right.svg");
    out property <image> chevron-down: @image-url("icons/chevron-down.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> audio: @image-url("icons/audio.svg");
    out property <image> subtitles: @image-url("icons/subtitles.svg");
    out property <image> normalize: @image-url("icons/normalize.svg");
    out property <image> next: @image-url("icons/next.svg");
    out property <image> star: @image-url("icons/star.svg");
    out property <image> bolt: @image-url("icons/bolt.svg");
    out property <image> download: @image-url("icons/download.svg");
    out property <image> rewind: @image-url("icons/rewind.svg");
    out property <image> forward: @image-url("icons/forward.svg");
    out property <image> phone: @image-url("icons/phone.svg");
    out property <image> keyboard: @image-url("icons/keyboard.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> backspace: @image-url("icons/backspace.svg");
    out property <image> space: @image-url("icons/space.svg");
    out property <image> filter: @image-url("icons/filter.svg");
    out property <image> alert: @image-url("icons/alert.svg");
}
